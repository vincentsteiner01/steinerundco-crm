{
  "name": "steinerundco-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 8768 --strictPort --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8769",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "test": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "e2e": "playwright test",
    "types": "supabase gen types --lang=typescript --project-id ekaqkfgvisdngsskzbai --schema public,crm > src/types/database.ts && prettier --write src/types/database.ts",
    "db:query": "bash tools/db-query.sh",
    "db:migrate": "bash tools/db-migrate.sh",
    "db:migrate:dry": "bash tools/db-migrate.sh --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.19",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "modern-screenshot": "4.7.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
