{
  "name": "steinerundco-crm-erweiterung",
  "private": true,
  "version": "1.1.0",
  "description": "Steiner & Co. CRM für LinkedIn – Chrome-Erweiterung (Manifest V3), liest nur auf Klick, sendet nie etwas auf LinkedIn.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:schnell": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "python3 -I scripts/icons.py",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
