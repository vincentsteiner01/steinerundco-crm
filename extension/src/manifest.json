{
  "manifest_version": 3,
  "name": "Steiner & Co. CRM für LinkedIn",
  "short_name": "S&Co. CRM",
  "version": "0.0.0",
  "description": "Zeigt beim Arbeiten auf LinkedIn, wer die Person im CRM ist, und die nächste vorbereitete Nachricht. Liest nur auf Klick, sendet nie etwas.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Steiner & Co. CRM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "optionen.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "scripting", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/*", "https://ekaqkfgvisdngsskzbai.supabase.co/*"],
  "commands": {
    "seitenleiste-oeffnen": {
      "suggested_key": { "default": "Alt+C", "mac": "Alt+C" },
      "description": "CRM-Seitenleiste öffnen"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
